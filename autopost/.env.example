# Токен бота из @BotFather (скопируйте этот файл в .env и впишите значения; .env никому не показывайте)
TELEGRAM_BOT_TOKEN=
# Ваш chat id. Узнать: напишите боту /start и выполните  python aion_daily.py chat-id
# Можно несколько через запятую.
TELEGRAM_CHAT_ID=
# Необязательно: прокси для Telegram, например http://127.0.0.1:10809
TELEGRAM_PROXY=
