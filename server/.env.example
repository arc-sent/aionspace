# Токен бота @aionspace_bot из @BotFather (тот же, что в autopost\.env). Файл никому не показывайте.
TELEGRAM_TOKEN=
# Ваш chat id (узнать: autopostat_id.bat): сюда приходят сводка, карточки на утверждение и уведомления
ADMIN_CHAT_ID=
# Канал, куда публиковать (бот должен быть админом с правом публикации)
CHANNEL_ID=@aion_space
# Время выхода постов по Москве, через запятую
SLOTS=13,15,17,21
# Токен API для ноутбука: длинная случайная строка (openssl rand -hex 32). Тот же — в autopost\.env
AION_API_TOKEN=

# Необязательно
# EXPIRE_HOURS=24          через сколько часов неутверждённый пост снимается
# TELEGRAM_PROXY=          на сервере не нужен; для запуска на ноутбуке: http://127.0.0.1:10809
# AION_API_PORT=8788

# ВК (необязательно): посты выходят и на стену группы в тот же слот. Пусто — только Telegram.
# Токен пользователя-админа группы с правами wall, photos, offline (токен сообщества не подходит).
# VK_TOKEN=
# Ссылка на группу, короткое имя или id: https://vk.com/aion_space
# VK_GROUP=

# Дзен (необязательно): статьи выходят в отдельный Telegram-канал, который @zen_sync_bot переносит в Дзен.
# Бот @aionspace_bot должен быть админом этого канала с правом публикации. Пусто — статьи не принимаются.
# DZEN_CHANNEL_ID=@interesOKosmose
# Время выхода статей по Москве
# DZEN_SLOTS=13,15
# Крючок на основной канал, если Claude его не написал
# DZEN_CTA=Каждый день новости космоса простыми словами — в Telegram-канале Aion Space: t.me/aion_space
